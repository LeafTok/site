#!/usr/bin/env bash
#
# Pre-push gate: never push source that does not type-check, lint, and build.
#
# This hook deliberately does NOT produce or commit the build output. By the time
# pre-push runs, git has already decided which commits are being sent, so a commit
# created here would not be part of the push — you would end up publishing source
# without the matching build and never notice. Building the artifact is the job of
# `npm run deploy`, which is explicit and runs against a committed tree.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass for an emergency: git push --no-verify
set -euo pipefail

# Only gate pushes to the deployed branch. Feature branches stay cheap to push.
PROTECTED="refs/heads/main"
should_check=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "$PROTECTED" ]; then
        should_check=1
    fi
done

if [ "$should_check" -eq 0 ]; then
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: verifying main…"
npm run type-check
npm run lint
npm run build
echo "pre-push: ok — remember 'npm run deploy' to publish the built site."
